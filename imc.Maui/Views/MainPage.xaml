<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="imc.Maui.Views.MainPage"
             Title="Indice de masa corporal"
             >

    <ScrollView>
        <Grid
         Padding="24" 
         RowDefinitions="Auto, Auto, *"
         ColumnDefinitions="*"
         RowSpacing="24">
            
            
            <Border
             Stroke="LightGray"
             StrokeThickness="2">

                <Border.StrokeShape>
                    <RoundRectangle
                     CornerRadius="10"/>
                </Border.StrokeShape>


                <Grid
                 ColumnDefinitions="Auto, *"
                 RowDefinitions="*, *"
                 ColumnSpacing="8">

                    <Label
                     Grid.Row="0"
                     Grid.Column="0"
                     VerticalOptions="Center"
                     Text="Proporcione el peso en kilogramos"/>
                    
                    <Entry
                     Text="{Binding Path=Peso}"
                     Grid.Row="0"
                     Grid.Column="1"
                     BackgroundColor="WhiteSmoke"
                     MaxLength="10"/>
                    
                    <Label
                     Grid.Row="1"
                     VerticalOptions="Center"
                     Grid.Column="0"
                     Text="Proporcione estatura en metros"/>
                    
                    
                    <Entry
                     Text="{Binding Path=Estatura}"
                     Grid.Row="1"
                     Grid.Column="1"
                     BackgroundColor="WhiteSmoke"/>
                </Grid>
            </Border>

            <HorizontalStackLayout
             Grid.Row="1"
             Grid.Column="0"
             HorizontalOptions="Center"
             Spacing="24">

                <Button
                 Command="{Binding Path=CalcularCommand}"
                 Text="Calcular"
                 BackgroundColor="Green"/>
                
                
                <Button
                 Command="{Binding Path=LimpiarCommand}"
                 Text="Limpiar"/>
                
                
            </HorizontalStackLayout>

            <Border
             Grid.Row="2"
             Grid.Column="0">
                
                
                <VerticalStackLayout>
                    <Label
                     Text="El indice de masa corporal es:"/>

                    <Label
                     Text="{Binding Path=Imc}"
                     HorizontalOptions="Center"
                     FontSize="Medium"
                     FontAttributes="Bold"/>
                    
                    <Label
                     Text="La situacion nutricional de la persona es:"/>
                    
                    <Label    
                     Text="{Binding Path=EstadoNutricional}"
                     HorizontalOptions="Center"
                     FontSize="Medium"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>


</ContentPage>