<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="imc.Maui.Views.MainPage"
             Title="Indice de masa corporal"
             >

    <ScrollView>
        <Grid
             Padding="24" 
             RowDefinitions="Auto, Auto, *"
            ColumnDefinitions="*"
            RowSpacing="24"
            >
            <Border
          Stroke="LightGray"
          StrokeThickness="2">

                <Border.StrokeShape>
                    <RoundRectangle
                     CornerRadius="10"/>
                </Border.StrokeShape>


                <Grid
                    RowDefinitions="*, *"
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="8">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalOptions="Center"
                       Text="Proporcione el peso en gramos"/>
                    <Entry
                    Grid.Row="0"
                    Grid.Column="1"
                    x:Name="PesoEntry"
                    BackgroundColor="WhiteSmoke"
                    MaxLength="10"/>
                    <Label
                        Grid.Row="1"
                        VerticalOptions="Center"
                        Grid.Column="0"
                  Text="Proporcione estatura en metros"/>
                    <Entry
                        Grid.Row="1"
                        Grid.Column="1"
                     x:Name="EstaturaEntry"
                     BackgroundColor="WhiteSmoke"/>
                </Grid>
            </Border>

            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="0"
          HorizontalOptions="Center"
          Spacing="24">

                <Button
              Text="Calcular"
              BackgroundColor="Green"
              Clicked="OnCalCularButtonClicked"
                    
                    />
                <Button
              Text="Limpiar"
              Clicked="OnLimpiarButtonClicked"
                    
                    />
            </HorizontalStackLayout>

            <Border
             Grid.Row="2"
             Grid.Column="0">
                
                
                <VerticalStackLayout>
                    <Label
                        
 
                  Text="El indice de masa corporal es:"/>
                    <Label
                                               x:Name="ImcLabel"
                  Text="23.4567"
                  HorizontalOptions="Center"
                  FontSize="Medium"
                  FontAttributes="Bold"/>
                    <Label
                  Text="La situacion nutricional de la persona es:"/>
                    <Label
                        
                        x:Name="SituacionNutricionalLabel"
                    Text="Peso normal"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                  />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>


</ContentPage>